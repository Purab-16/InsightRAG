ENV=development                # set to production on Render
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=             # current free Flash model from AI Studio
GEMINI_FALLBACK_MODEL=         # used when the chat model returns 429 / quota error
GEMINI_EMBED_MODEL=            # current embedding model
EMBED_DIM=768
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # backend only, never in frontend
S2_API_KEY=                    # optional
ALLOWED_ORIGINS=http://localhost:3000
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K_PER_PAPER=5
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=100
PARSE_TIMEOUT_S=60
PARSE_MEMORY_MB=300
DAILY_PAPER_LIMIT=5
DAILY_MESSAGE_LIMIT=30
GLOBAL_DAILY_AI_LIMIT=450
RATE_LIMIT_PER_MIN=60
