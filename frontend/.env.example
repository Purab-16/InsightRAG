# Copy to .env.local and fill in. Only public values belong here (NEXT_PUBLIC_ is sent to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # the anon / publishable key, never the service role key
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=     # optional, enabled at deploy time
